# Production template — copy to /srv/bestiary/current/.env on the VPS and fill
# in the real secrets. NEVER commit the resulting .env.
#
# Naming convention: this file's `.example` sibling stays in the repo; the
# real .env stays only on the host.

NODE_ENV=production

# Postgres — role `bestiary_app` on the shared instance (see
# infra/postgres/init-bestiary.sql). Password goes here, nowhere else.
DATABASE_URL=postgres://bestiary_app:REPLACE_WITH_STRONG_PASSWORD@localhost:5434/bestiary_prod

# Any random 24+ chars. Only agents that hold this key can POST/PATCH.
# `openssl rand -base64 32` or `head -c 32 /dev/urandom | base64` will do.
API_KEY=REPLACE_WITH_RANDOM_24_PLUS_CHARS

# Port the PM2-managed api listens on (localhost only; Nginx proxies to it).
API_PORT=5610

# Only origin allowed to hit the api from a browser. Cloudflare in front is
# fine because it forwards the original Origin header.
CORS_ORIGIN=https://bestiary.sysnode.com.br

# Where the seed looks for the original .docx/.xlsx files. On the VPS this is
# usually empty or points to a per-machine location — the seed prints [skip]
# for missing files and moves on.
FONTES_DIR=./fontes
