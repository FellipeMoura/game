{
  "name": "bestiary",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm db:check-stale && pnpm -r --parallel --stream run dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "db:create": "pnpm --filter @bestiary/db run create",
    "db:generate": "pnpm --filter @bestiary/db run generate",
    "db:migrate": "pnpm --filter @bestiary/db run migrate",
    "db:seed": "pnpm --filter @bestiary/db run seed",
    "db:pull": "pnpm --filter @bestiary/db run pull",
    "db:check-stale": "pnpm --filter @bestiary/db run check-stale",
    "db:studio": "pnpm --filter @bestiary/db run studio",
    "db:reset": "pnpm db:create && pnpm db:generate && pnpm db:migrate && pnpm db:seed",
    "openapi:generate": "pnpm --filter @bestiary/web run openapi:generate"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
