# Shared config — copy to .env at the repo root.
DATABASE_URL=postgres://postgres:postgres@localhost:5102/bestiary
API_KEY=change-me-before-running
API_PORT=5101
NODE_ENV=development
# Empty in dev = permissive CORS (origin: true). Set to a comma-separated list
# in production, e.g. https://bestiary.sysnode.com.br
CORS_ORIGIN=
FONTES_DIR=./fontes
# `pnpm db:pull` hydrates dev with a snapshot of prod. Two transports:
#   PULL_MODE=api (default) — fetches from the public GET endpoints. No setup.
#     Override host with PROD_API_URL (defaults to https://bestiary.sysnode.com.br).
#   PULL_MODE=db — direct Postgres. Faster, needs an SSH tunnel since prod
#     doesn't expose 5432 publicly. Example:
#       ssh -L 5434:localhost:5434 user@bestiary.sysnode.com.br
#     Then set PROD_DATABASE_URL to the tunneled URL.
PULL_MODE=
PROD_API_URL=
PROD_DATABASE_URL=
