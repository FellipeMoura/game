# Shared config — copy to .env at the repo root.
DATABASE_URL=postgres://postgres:postgres@localhost:5102/bestiary
API_KEY=change-me-before-running
API_PORT=5101
NODE_ENV=development
# Empty in dev = permissive CORS (origin: true). Set to a comma-separated list
# in production, e.g. https://bestiary.sysnode.com.br
CORS_ORIGIN=
FONTES_DIR=./fontes
